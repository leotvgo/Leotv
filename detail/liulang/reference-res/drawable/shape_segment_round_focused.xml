<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <stroke
                android:width="2dp"
                android:color="#4de50914"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="0dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient
                android:startColor="#e50914"
                android:endColor="#ff6b6b"
                android:angle="315"
                android:type="linear"/>
            <padding
                android:left="10dp"
                android:top="0dp"
                android:right="10dp"
                android:bottom="0dp"/>
        </shape>
    </item>
</layer-list>
