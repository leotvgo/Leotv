<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:paddingBottom="0dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:stateListAnimator="@null"
    android:outlineProvider="none"
    android:defaultFocusHighlightEnabled="false">
    <FrameLayout
        android:id="@+id/imageWrapper"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:background="@color/black_20"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Grid.Large"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="end|top"
            android:id="@+id/tmdbTag"
            android:background="@drawable/bg_tmdb_tag"
            android:paddingTop="0dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/home_tmdb_tag"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"/>
        <View
            android:layout_gravity="start|top"
            android:id="@+id/siteGradient"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="96dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="start|top"
            android:id="@+id/siteTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:shadowColor="@color/black"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"/>
    </FrameLayout>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/delete"
        android:background="@color/black_50"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_vod_delete"
        android:scaleType="center"
        android:layout_alignTop="@+id/imageWrapper"
        android:layout_alignBottom="@+id/imageWrapper"
        android:layout_alignStart="@+id/imageWrapper"
        android:layout_alignEnd="@+id/imageWrapper"
        app:shapeAppearanceOverlay="@style/Vod.Grid.Large"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="13sp"
        android:textColor="#ccffffff"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_below="@+id/imageWrapper"
        android:layout_alignStart="@+id/imageWrapper"
        android:layout_alignEnd="@+id/imageWrapper"/>
</RelativeLayout>
