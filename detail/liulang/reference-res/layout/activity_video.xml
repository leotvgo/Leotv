<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video"
        android:background="@color/black"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/video"
        android:nextFocusRight="@+id/content"
        android:nextFocusUp="@+id/video"
        android:nextFocusDown="@+id/flag"
        android:layout_width="400dp"
        android:layout_height="225dp"
        android:layout_margin="24dp"
        android:foreground="@drawable/selector_video"
        android:defaultFocusHighlightEnabled="false">
        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none"
            style="@style/Player.Vod"/>
        <include
            android:id="@+id/widget"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/view_widget_vod"/>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/control"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_control_vod"/>
        <include
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/view_progress"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="end|top"
            android:id="@+id/preloadLottie"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:layout_margin="8dp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/preload_success"/>
    </FrameLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:singleLine="true"
        android:layout_marginEnd="24dp"
        android:layout_toEndOf="@+id/video"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_below="@+id/name"
        android:layout_marginEnd="24dp"
        android:layout_alignStart="@+id/name"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/row1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/remark"
        android:layout_marginEnd="24dp"
        android:layout_alignStart="@+id/remark">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="12dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="12dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="12dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/director"
        android:nextFocusDown="@+id/actor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_below="@+id/row1"
        android:layout_marginEnd="24dp"
        android:layout_alignStart="@+id/name"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/actor"
        android:nextFocusDown="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:layout_below="@+id/director"
        android:layout_marginEnd="24dp"
        android:layout_alignStart="@+id/name"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/row2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/video"
        android:layout_alignStart="@+id/name">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/content"
            android:background="@drawable/selector_item"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/actor"
            android:nextFocusDown="@+id/flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_desc"
            android:singleLine="true"
            android:drawablePadding="6dp"
            android:layout_marginEnd="16dp"
            app:drawableStartCompat="@drawable/ic_detail_desc"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/keep"
            android:background="@drawable/selector_item"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/actor"
            android:nextFocusDown="@+id/flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keep"
            android:singleLine="true"
            android:drawablePadding="6dp"
            android:layout_marginEnd="16dp"
            app:drawableStartCompat="@drawable/ic_detail_keep_off"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/change"
            android:background="@drawable/selector_item"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/change"
            android:nextFocusUp="@+id/actor"
            android:nextFocusDown="@+id/flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_change"
            android:singleLine="true"
            android:drawablePadding="6dp"
            app:drawableStartCompat="@drawable/ic_detail_change"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/video"
        android:overScrollMode="never">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/quality"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/part"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/quick"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/episodePanel"
        android:background="@drawable/bg_episode_list_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <View
                    android:background="@drawable/shape_red_bar"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放线路"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/flag"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="24dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/shape_red_bar"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选集"/>
                <androidx.leanback.widget.HorizontalGridView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/array"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="8dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episode"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:overScrollMode="never"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:nestedScrollingEnabled="false"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</com.fongmi.android.tv.ui.custom.ProgressLayout>
