<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/clock"
            style="@style/Shadow"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"
            android:layout_alignStart="@+id/title"
            style="@style/Shadow"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFeatureSettings="tnum"
            style="@style/Shadow"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error"
        android:background="@drawable/shape_widget"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_error"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/center"
        android:background="@drawable/shape_widget"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/action"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_play"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/speed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_widget_forward"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_gravity="start|top"
        android:id="@+id/resolution"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:fontFeatureSettings="tnum"
        style="@style/Shadow"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_gravity="end|top"
        android:id="@+id/netSpeed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:fontFeatureSettings="tnum"
        style="@style/Shadow"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/vodLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:layout_marginBottom="90dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:alpha="0"
        android:layout_marginStart="24dp"/>
</FrameLayout>
