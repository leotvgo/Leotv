<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search"
            android:background="@drawable/selector_config_delete_background"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/search"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_site_search"
            app:tint="@color/selector_config_item_delete"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sort"
            android:background="@drawable/selector_config_delete_background"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/sort"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_site_sort"
            app:tint="@color/selector_config_item_delete"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/all"
            android:background="@drawable/selector_config_delete_background"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/all"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shape_check_circle_on"
            app:tint="@color/selector_config_item_delete"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/none"
            android:background="@drawable/selector_config_delete_background"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/none"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shape_check_circle_off"
            app:tint="@color/selector_config_item_delete"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:background="@drawable/shape_line_tapered"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:overScrollMode="never"/>
</androidx.appcompat.widget.LinearLayoutCompat>
