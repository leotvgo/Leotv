<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item"
        android:background="@drawable/selector_site_item_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:weightSum="94">
        <View
            android:id="@+id/left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="14"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/selector_site_item_text"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/text"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="60"/>
        <View
            android:id="@+id/gap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8"/>
        <FrameLayout
            android:id="@+id/check_box"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/check"
                android:background="@drawable/selector_check_circle"
                android:duplicateParentState="true"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <View
            android:id="@+id/right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/line"
        android:background="@drawable/shape_line_tapered"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
