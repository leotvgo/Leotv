<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/heroBgUnder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <com.fongmi.android.tv.ui.custom.HeroImageView
        android:id="@+id/heroBg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/maskLeft"
        android:background="@drawable/bg_hero_mask_h"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/maskBottom"
        android:background="@drawable/bg_hero_mask_v"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="start|top"
        android:id="@+id/pageSite"
        android:background="@drawable/shape_config_name"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_margin="24dp"
        android:maxLines="1"
        android:paddingHorizontal="12dp"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/posterCard"
        android:background="@drawable/shape_poster_card"
        android:padding="4dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="80dp"
        android:clipToOutline="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/posterCardImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
    </FrameLayout>
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/posterContent"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="bottom"
                    android:id="@+id/heroNameText"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:shadowColor="#cc000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="12"/>
                <ImageView
                    android:id="@+id/heroLogoImg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:maxWidth="720dp"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="14sp"
                    android:textColor="#ccffffff"
                    android:gravity="bottom"
                    android:id="@+id/heroMetaText"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:shadowColor="#aa000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.5"
                    android:shadowRadius="8"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:weightSum="2">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="12sp"
                        android:textColor="#bbffffff"
                        android:ellipsize="end"
                        android:id="@+id/heroDescText"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:maxLines="2"
                        android:shadowColor="#aa000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="6"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/resumeRow"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <com.fongmi.android.tv.ui.custom.CustomTypeView
                    android:textSize="14sp"
                    android:textColor="@color/selector_type_text"
                    android:gravity="center"
                    android:id="@+id/btnResume"
                    android:background="@drawable/selector_item_round_resume"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="invisible"
                    android:nextFocusUp="@+id/homeBtn"
                    android:nextFocusDown="@+id/posterRecycler"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/history_view_detail"
                    android:drawablePadding="4dp"
                    app:drawableStartCompat="@drawable/ic_arrow_down_circle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/progressGroup"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.fongmi.android.tv.ui.custom.MarqueeTextView
                            android:textSize="12sp"
                            android:textColor="#ccffffff"
                            android:id="@+id/progressEpisode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:shadowColor="#aa000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#ccffffff"
                            android:id="@+id/progressTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:shadowColor="#aa000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                    <com.fongmi.android.tv.ui.custom.HistoryProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="215dp">
                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/posterRecycler"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="215dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    app:focusOutEnd="true"
                    app:focusOutFront="true"/>
            </FrameLayout>
        </LinearLayout>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/deleteAllBox"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deleteAll"
            android:background="@drawable/selector_history_delete_bg"
            android:padding="5dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/deleteAll"
            android:nextFocusRight="@+id/deleteAll"
            android:nextFocusUp="@+id/deleteAll"
            android:nextFocusDown="@+id/posterRecycler"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_vod_delete"
            android:scaleType="fitCenter"
            android:contentDescription="@string/history_delete_all_title"
            android:stateListAnimator="@null"
            android:defaultFocusHighlightEnabled="false"/>
    </FrameLayout>
</FrameLayout>
