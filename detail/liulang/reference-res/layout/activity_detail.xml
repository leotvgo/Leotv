<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/heroBgUnder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <com.fongmi.android.tv.ui.custom.HeroImageView
        android:id="@+id/heroBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/maskLeft"
        android:background="@drawable/bg_hero_mask_h"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/maskBottom"
        android:background="@drawable/bg_hero_mask_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/posterCard"
        android:background="@drawable/shape_poster_card"
        android:padding="4dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="80dp"
        android:clipToOutline="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/posterCardImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
    </FrameLayout>
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/detailTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="6dp">
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="bottom"
                    android:id="@+id/name"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:shadowColor="#cc000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="12"/>
                <ImageView
                    android:id="@+id/heroLogoImg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:maxWidth="720dp"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="14sp"
                    android:textColor="#ccffffff"
                    android:gravity="bottom"
                    android:id="@+id/meta"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:shadowColor="#aa000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.5"
                    android:shadowRadius="8"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:weightSum="2">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="12sp"
                        android:textColor="#bbffffff"
                        android:ellipsize="end"
                        android:id="@+id/desc"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:maxLines="2"
                        android:shadowColor="#aa000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="6"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/play"
                        android:background="@drawable/selector_detail_play"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/play"
                        android:drawablePadding="4dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="12dp"
                        app:drawableStartCompat="@drawable/ic_widget_play"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/keep"
                        android:background="@drawable/selector_detail_item"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/keep"
                        android:drawablePadding="4dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="12dp"
                        app:drawableStartCompat="@drawable/ic_detail_keep_off"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/change"
                        android:background="@drawable/selector_detail_item"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusRight="@+id/change"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/play_change"
                        android:drawablePadding="4dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:drawableStartCompat="@drawable/ic_detail_change"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/listSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:id="@+id/flagLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="2dp">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <View
                                android:background="@drawable/shape_red_bar"
                                android:layout_width="4dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="播放线路"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/flag"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="24dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:id="@+id/episodeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0dp">
                            <View
                                android:background="@drawable/shape_red_bar"
                                android:layout_width="4dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="选集"/>
                            <androidx.leanback.widget.HorizontalGridView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/segment"
                                android:focusable="false"
                                android:visibility="gone"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:layout_marginStart="8dp"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.recyclerview.widget.RecyclerView
                            android:scrollbarStyle="outsideOverlay"
                            android:id="@+id/episode"
                            android:scrollbars="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"/>
                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/episodeEmpty"
                            android:visibility="gone"
                            android:layout_width="96dp"
                            android:layout_height="88dp"
                            android:layout_marginTop="4dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/empty"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.fongmi.android.tv.ui.custom.TypingDotsView
                    android:layout_gravity="center"
                    android:id="@+id/listProgress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>
</FrameLayout>
